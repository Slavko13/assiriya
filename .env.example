COMPOSE_PROJECT_NAME=avtozakup

# Local HTTP endpoint.
WP_PORT=8080
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080

# Development-only database credentials. Replace them outside a local machine.
MARIADB_DATABASE=avtozakup
MARIADB_USER=avtozakup
MARIADB_PASSWORD=change-me-local-db-password
MARIADB_ROOT_PASSWORD=change-me-local-root-password
WORDPRESS_TABLE_PREFIX=wp_

# Initial administrator. bootstrap-wordpress.sh is idempotent and will not reset
# this password after WordPress has been installed.
WP_ADMIN_USER=avtozakup_admin
WP_ADMIN_PASSWORD=change-me-local-admin-password
WP_ADMIN_EMAIL=admin@example.test
WP_SITE_TITLE=АВТОЗАКУП
WP_LOCALE=ru_RU
WP_TIMEZONE=Europe/Moscow

WP_ENVIRONMENT_TYPE=local
WORDPRESS_DEBUG=1
WORDPRESS_FORCE_SSL_ADMIN=false
WP_THEME=avtozakup
WP_PLUGIN=avtozakup-core
WOOCOMMERCE_VERSION=11.2.1
