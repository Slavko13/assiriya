COMPOSE_PROJECT_NAME=avtozakup

# Use the real public IP and selected free port after server diagnostics.
PUBLIC_URL=http://SERVER_IP:8090
CADDY_HTTP_PORT=8090

# Restrict /wp-login.php and /wp-admin to one trusted IP/CIDR. For remote
# administration, use a VPN/SSH tunnel or HTTPS through the existing proxy.
ADMIN_ALLOWED_CIDR=YOUR.TRUSTED.IP.ADDRESS/32
WORDPRESS_FORCE_SSL_ADMIN=false

MARIADB_DATABASE=avtozakup
MARIADB_USER=avtozakup
MARIADB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
MARIADB_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD
WORDPRESS_TABLE_PREFIX=wp_

WP_ADMIN_USER=avtozakup_admin
WP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ADMIN_PASSWORD
WP_ADMIN_EMAIL=admin@example.com
WP_SITE_TITLE=АВТОЗАКУП
WP_LOCALE=ru_RU
WP_TIMEZONE=Europe/Moscow

WP_ENVIRONMENT_TYPE=production
WORDPRESS_DEBUG=0
WP_THEME=avtozakup
WP_PLUGIN=avtozakup-core
WOOCOMMERCE_VERSION=11.2.1

# Deployment controls.
DEPLOY_BRANCH=main
BACKUP_DIR=/opt/avtozakup-backups
BACKUP_RETENTION_DAYS=14
ROLLBACK_DATABASE_ON_FAILURE=0
