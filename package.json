{
  "name": "avtozakup-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright acceptance and visual checks for the АВТОЗАКУП WordPress MVP",
  "scripts": {
    "test:preflight": "node --test tests/config/documentation.test.mjs tests/config/playwright-env.test.mjs tests/config/quick-tunnel.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1"
  }
}
